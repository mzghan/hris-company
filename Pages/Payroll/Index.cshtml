@page
@model HRIS.Api.Pages.Payroll.IndexModel
@{
    ViewData["Title"] = "Payroll";
}

<h4 class="mb-3">Payroll</h4>

<div class="row g-3">
    @if (Model.IsAdmin)
    {
        <div class="col-md-4">
            <div class="card p-3">
                <h6>Buat Periode Payroll Baru</h6>
                <p class="text-muted small">Sistem akan generate perhitungan gaji tiap karyawan aktif berdasarkan data gaji terbaru.</p>
                <form method="post" asp-page-handler="Create">
                    <div class="mb-2">
                        <label class="form-label small">Bulan</label>
                        <input asp-for="Input.Month" type="number" min="1" max="12" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Tahun</label>
                        <input asp-for="Input.Year" type="number" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">Buat Periode</button>
                </form>
            </div>
        </div>
    }
    <div class="@(Model.IsAdmin ? "col-md-8" : "col-md-12")">
        @if (Model.PendingForMe.Any())
        {
            <div class="alert alert-warning">
                Ada <strong>@Model.PendingForMe.Count</strong> periode payroll menunggu persetujuan kamu.
            </div>
        }
        <div class="card p-3">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Periode</th>
                        <th>Status</th>
                        <th>Level Saat Ini</th>
                        <th>Total Net Pay</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Periods)
                    {
                        <tr>
                            <td>@p.Month/@p.Year</td>
                            <td><span class="status-@p.Status">@p.Status</span></td>
                            <td>@p.CurrentLevel</td>
                            <td>@p.TotalNetPay.ToString("N0")</td>
                            <td class="text-end">
                                <a asp-page="/Payroll/Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Detail</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Periods.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">Belum ada periode payroll.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

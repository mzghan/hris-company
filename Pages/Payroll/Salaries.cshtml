@page
@model HRIS.Api.Pages.Payroll.SalariesModel
@{
    ViewData["Title"] = "Gaji Karyawan";
}

<h4 class="mb-3">Data Gaji Karyawan</h4>

<div class="card p-3 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small">Pilih Karyawan</label>
            <select name="employeeId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Pilih karyawan --</option>
                @foreach (var opt in Model.EmployeeOptions)
                {
                    if (Model.EmployeeId?.ToString() == opt.Value)
                    {
                        <option value="@opt.Value" selected>@opt.Text</option>
                    }
                    else
                    {
                        <option value="@opt.Value">@opt.Text</option>
                    }
                }
            </select>
        </div>
    </form>
</div>

@if (Model.EmployeeId is not null)
{
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card p-3">
                <h6>Tambah Riwayat Gaji</h6>
                <p class="text-muted small">Untuk: @Model.SelectedEmployeeName</p>
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <form method="post">
                    <input type="hidden" asp-for="Input.EmployeeId" />
                    <div class="mb-2">
                        <label class="form-label small">Gaji Pokok</label>
                        <input asp-for="Input.BaseSalary" type="number" step="0.01" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Total Tunjangan</label>
                        <input asp-for="Input.AllowanceTotal" type="number" step="0.01" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Berlaku Sejak</label>
                        <input asp-for="Input.EffectiveDate" type="date" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">Simpan</button>
                </form>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card p-3">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Berlaku Sejak</th>
                            <th>Gaji Pokok</th>
                            <th>Tunjangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.History)
                        {
                            <tr>
                                <td>@s.EffectiveDate.ToString("dd MMM yyyy")</td>
                                <td>@s.BaseSalary.ToString("N0")</td>
                                <td>@s.AllowanceTotal.ToString("N0")</td>
                            </tr>
                        }
                        @if (!Model.History.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">Belum ada riwayat gaji.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

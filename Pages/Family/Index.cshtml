@page
@model HRIS.Api.Pages.Family.IndexModel
@{ ViewData["Title"] = "Data Keluarga"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="mb-1">Data Keluarga</h4><p class="text-muted small mb-0">Perubahan diajukan terlebih dahulu dan baru masuk ke master setelah disetujui HR.</p></div><a class="btn btn-outline-secondary btn-sm" asp-page="/Approvals/Index">Lihat Approval</a></div>
<div class="row g-3">
<div class="col-lg-5"><div class="card p-3"><h6>Ajukan Perubahan</h6><form method="post" asp-page-handler="Save"><div class="mb-2"><label class="form-label small">Aksi</label><select name="action" class="form-select" id="familyAction" onchange="toggleFamilyId()"><option value="Add">Tambah</option><option value="Update">Ubah</option><option value="Delete">Hapus</option></select></div><div class="mb-2"><label class="form-label small">Data keluarga (untuk Ubah/Hapus)</label><select name="familyId" class="form-select"><option value="">-- data baru --</option>@foreach(var f in Model.Families){<option value="@f.Id">@f.FamilyName - @f.RelationshipName</option>}</select></div><div class="mb-2"><label class="form-label small">Nama</label><input name="familyName" class="form-control" maxlength="150" required /></div><div class="mb-2"><label class="form-label small">Hubungan</label><select name="relationshipId" class="form-select" required>@foreach(var r in Model.Relationships){<option value="@r.Id">@r.Name</option>}</select></div><div class="mb-2"><label class="form-label small">Gender</label><select name="genderId" class="form-select"><option value="">-- pilih --</option>@foreach(var g in Model.Genders){<option value="@g.Id">@g.Name</option>}</select></div><div class="row g-2 mb-2"><div class="col"><label class="form-label small">Tanggal lahir</label><input name="birthDate" type="date" class="form-control" /></div><div class="col"><label class="form-label small">Tanggal pernikahan</label><input name="weddingDate" type="date" class="form-control" /></div></div><div class="form-check mb-3"><input name="isDependent" value="true" class="form-check-input" type="checkbox" id="dependent" /><label class="form-check-label" for="dependent">Tanggungan</label></div><button class="btn btn-primary">Ajukan</button></form></div></div>
<div class="col-lg-7"><div class="card p-3 mb-3"><h6 class="mb-3">Data Keluarga Saat Ini</h6><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Nama</th><th>Hubungan</th></tr></thead><tbody>@foreach(var f in Model.Families){<tr><td>@f.FamilyName</td><td>@f.RelationshipName</td></tr>}@if(!Model.Families.Any()){<tr><td colspan="2" class="text-muted">Belum ada data keluarga.</td></tr>}</tbody></table></div></div><div class="card p-3"><h6 class="mb-3">Riwayat Pengajuan</h6><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Nama</th><th>Aksi</th><th>Status</th><th>Approval</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.FamilyName<br/><span class="small text-muted">@x.RelationshipName</span></td><td>@x.Action</td><td><span class="status-@x.Status">@x.Status</span></td><td>@(x.ApprovalId is null ? "-" : "#"+x.ApprovalId)</td></tr>}@if(!Model.Items.Any()){<tr><td colspan="4" class="text-center text-muted py-4">Belum ada pengajuan.</td></tr>}</tbody></table></div></div></div></div>
@section Scripts { <script>function toggleFamilyId(){const a=document.getElementById('familyAction').value; document.querySelector('[name=familyId]').disabled=a==='Add';}</script> }

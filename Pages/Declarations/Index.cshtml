@page
@model HRIS.Api.Pages.Declarations.IndexModel
@{ ViewData["Title"] = "Declaration Letter"; }
<div class="row g-3"><div class="col-lg-5"><div class="card p-3"><h6>Deklarasi Aktif</h6>@foreach(var t in Model.Templates){<div class="border rounded p-3 mb-2"><strong>@t.Title</strong><p class="small text-muted mt-2 mb-2" style="white-space:pre-wrap;max-height:180px;overflow:auto">@t.Content</p><form method="post" asp-page-handler="Submit"><input type="hidden" name="templateId" value="@t.Id"/><button class="btn btn-sm btn-primary" onclick="return confirm('Saya menyetujui isi deklarasi ini.')">Saya Setuju</button></form></div>}@if(!Model.Templates.Any()){<p class="text-muted small">Belum ada template aktif.</p>}</div>@if(Model.CanManage){<div class="card p-3 mt-3"><h6>Tambah Template</h6><form method="post" asp-page-handler="SaveTemplate"><input name="title" class="form-control mb-2" placeholder="Judul" required/><textarea name="content" class="form-control mb-2" rows="6" placeholder="Isi deklarasi" required></textarea><button class="btn btn-outline-primary">Simpan Template</button></form></div>}</div><div class="col-lg-7"><div class="card p-3"><h6 class="mb-3">Riwayat Pernyataan</h6><table class="table table-hover"><thead><tr><th>Pengaju</th><th>Template</th><th>Waktu</th></tr></thead><tbody>@foreach(var x in Model.Submissions){<tr><td>@x.EmployeeName</td><td>@x.TemplateTitle</td><td>@x.AgreedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>}@if(!Model.Submissions.Any()){<tr><td colspan="3" class="text-center text-muted py-4">Belum ada pernyataan.</td></tr>}</tbody></table></div></div></div>

@page
@model HRIS.Api.Pages.Forms.IndexModel
@{
    ViewData["Title"] = "HR Forms";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h4 class="mb-1">HR Forms</h4><div class="text-muted small">Formulir HR yang dapat diunduh karyawan.</div></div>
    <a asp-page="/Documents/Index" class="btn btn-outline-secondary btn-sm">Semua Dokumen</a>
</div>

<div class="card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Formulir</th><th>Subkategori</th><th>Ukuran</th><th class="text-end">Aksi</th></tr></thead>
        <tbody>
        @foreach (var d in Model.Documents)
        {
            <tr>
                <td><div>@d.Title</div><div class="small text-muted">@d.FileName</div></td>
                <td>@d.CategoryName</td>
                <td>@((d.SizeBytes / 1024.0).ToString("N0")) KB</td>
                <td class="text-end"><a asp-page="/Documents/Index" asp-page-handler="Download" asp-route-id="@d.Id" class="btn btn-sm btn-primary">Unduh</a></td>
            </tr>
        }
        @if (!Model.Documents.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">Belum ada formulir.</td></tr> }
        </tbody>
    </table>
</div>

@if (Model.CanManage)
{
    <div class="card p-3 mt-3">
        <h6>Unggah Formulir</h6>
        <form method="post" enctype="multipart/form-data">
            <div class="row g-2">
                <div class="col-md-3"><input type="file" name="file" class="form-control" required /></div>
                <div class="col-md-3"><input type="text" name="title" class="form-control" placeholder="Judul" required /></div>
                <div class="col-md-3"><select name="categoryId" asp-items="Model.FormCategoryOptions" class="form-select" required><option value="">-- Kategori Forms --</option></select></div>
                <div class="col-md-3"><button class="btn btn-primary w-100">Unggah</button></div>
            </div>
        </form>
    </div>
}

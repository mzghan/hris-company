@{
    var isAuth = User.Identity != null && User.Identity.IsAuthenticated;
    var username = isAuth ? User.Identity!.Name : null;
    var roleText = isAuth ? string.Join(", ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value)) : null;
    var isHrOrSupport = isAuth && (User.IsInRole("HR") || User.IsInRole("Support"));
    var isEmployee = isAuth && User.IsInRole("Employee");
    // Manager/Head/Group Head bukan role tersimpan, tapi claim dari rantai atasan.
    var isManager = isAuth && User.HasClaim("IsManager", "true");
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HRIS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" asp-page="/Index">HRIS</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                @if (username != null)
                {
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>

                        @if (isHrOrSupport)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Employees/Index">Karyawan</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Organizations/Index">Organisasi</a></li>
                        }

                        @if (isEmployee)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Attendance/Index">Absensi</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Leave/Index">Cuti Saya</a></li>
                        }

                        @if (isManager || isHrOrSupport)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Leave/Approvals">Approval Cuti</a></li>
                        }

                        @if (isHrOrSupport)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">KPI</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-page="/Kpi/Criteria">Kriteria KPI</a></li>
                                    <li><a class="dropdown-item" asp-page="/Kpi/Periods">Periode KPI</a></li>
                                </ul>
                            </li>
                        }
                        @if (isManager)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Kpi/Review">Review KPI</a></li>
                        }
                    </ul>
                            </li>
                        }
                        @if (role == "Manager")
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Kpi/Review">Review KPI</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item d-flex align-items-center me-3 text-light small">
                            <span>@username <span class="badge bg-secondary">@roleText</span></span>
                        </li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="text-center text-muted my-5 small">
        HRIS &middot; .NET 8 + Razor Pages
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

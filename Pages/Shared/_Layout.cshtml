@inject HRIS.Api.Services.INotificationService NotificationService
@{
    var isAuth = User.Identity != null && User.Identity.IsAuthenticated;
    var username = isAuth ? User.Identity!.Name : null;
    var roleText = isAuth ? string.Join(", ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value)) : null;
    var isHrOrSupport = isAuth && (User.IsInRole("HR") || User.IsInRole("Support"));
    var isEmployee = isAuth && User.IsInRole("Employee");
    var isManager = isAuth && (User.HasClaim("IsManager", "true") || User.IsInRole("Manager") || User.IsInRole("Head"));
    var isHrManpower = isAuth && (isHrOrSupport || User.IsInRole("HRBP") || User.IsInRole("OE") || User.IsInRole("Admin") || User.IsInRole("TA") || User.IsInRole("Manager") || User.IsInRole("Head") || User.IsInRole("INTERN"));

    var unreadCount = 0;
    if (isAuth && int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var currentUserId))
    {
        try { unreadCount = await NotificationService.GetUnreadCountAsync(currentUserId); }
        catch { unreadCount = 0; }
    }
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HRIS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
@if (isAuth)
{
    <aside class="app-sidebar" id="appSidebar">
        <div class="sidebar-brand">
            <a asp-page="/Index">HRIS</a>
            <button type="button" class="sidebar-close d-lg-none" id="sidebarClose" aria-label="Tutup menu">&times;</button>
        </div>

        <div class="sidebar-user">
            <div class="sidebar-avatar">@(username?.Substring(0, Math.Min(username.Length, 1)).ToUpperInvariant())</div>
            <div class="min-w-0">
                <div class="fw-semibold text-truncate">@username</div>
                <div class="small text-white-50 text-truncate">@roleText</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-section">Workspace</div>
            <a class="sidebar-link" asp-page="/Index"><span class="sidebar-icon">⌂</span>Dashboard</a>
            <a class="sidebar-link" asp-page="/Notifications/Index"><span class="sidebar-icon">◔</span>Notifikasi @if(unreadCount>0){<span class="badge bg-danger ms-auto">@unreadCount</span>}</a>
            <a class="sidebar-link" asp-page="/Approvals/Index"><span class="sidebar-icon">✓</span>Approval</a>

            @if (isHrManpower)
            {
                <div class="sidebar-section">People &amp; Organization</div>
                <a class="sidebar-link" asp-page="/Employees/Index"><span class="sidebar-icon">♙</span>Karyawan</a>
                <a class="sidebar-link" asp-page="/Organizations/Index"><span class="sidebar-icon">⌘</span>Organisasi</a>
                var currentPath = Context.Request.Path.Value ?? string.Empty;
                var currentView = Context.Request.Query["view"].ToString();
                var approvalListOpen = currentPath.StartsWith("/Approvals", StringComparison.OrdinalIgnoreCase) && !currentView.StartsWith("manpower-", StringComparison.OrdinalIgnoreCase);
                var formJdOpen = currentPath.StartsWith("/JobDescriptions", StringComparison.OrdinalIgnoreCase);
                var jdManagementOpen = formJdOpen && (currentView == "bank-signature" || currentView == "bank" || currentView == "pending");
                var manpowerApprovalOpen = currentPath.StartsWith("/Approvals", StringComparison.OrdinalIgnoreCase) && currentView.StartsWith("manpower-", StringComparison.OrdinalIgnoreCase);
                var manpowerRequestOpen = currentPath.StartsWith("/Manpower", StringComparison.OrdinalIgnoreCase);
                <details class="sidebar-group" @(approvalListOpen ? "open" : "")>
                    <summary class="sidebar-link sidebar-parent"><span class="sidebar-icon">✓</span><span class="sidebar-parent-label">Approval List</span><span class="sidebar-chevron" aria-hidden="true"></span></summary>
                    <div class="sidebar-subnav">
                        <a class="sidebar-link sidebar-sublink" asp-page="/Approvals/Index" asp-route-view="pending">Pending Approval</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/Approvals/Index" asp-route-view="history">History</a>
                    </div>
                </details>
                <details class="sidebar-group" @(formJdOpen && !jdManagementOpen ? "open" : "")>
                    <summary class="sidebar-link sidebar-parent"><span class="sidebar-icon">JD</span><span class="sidebar-parent-label">Form JD</span><span class="sidebar-chevron" aria-hidden="true"></span></summary>
                    <div class="sidebar-subnav">
                        <a class="sidebar-link sidebar-sublink" asp-page="/JobDescriptions/Index" asp-route-view="input">Form Input JD</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/JobDescriptions/Index" asp-route-view="submitted">Submitted JD</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/JobDescriptions/Index" asp-route-view="sign-job-holder">Sign as Job Holder</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/JobDescriptions/Index" asp-route-view="sign-manager">Sign as Immediate Manager</a>
                    </div>
                </details>
                <details class="sidebar-group" @(jdManagementOpen ? "open" : "")>
                    <summary class="sidebar-link sidebar-parent"><span class="sidebar-icon">▤</span><span class="sidebar-parent-label">JD Management</span><span class="sidebar-chevron" aria-hidden="true"></span></summary>
                    <div class="sidebar-subnav">
                        <a class="sidebar-link sidebar-sublink" asp-page="/JobDescriptions/Index" asp-route-view="bank-signature">List Bank JD with Signature</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/JobDescriptions/Index" asp-route-view="bank">List Bank JD</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/JobDescriptions/Index" asp-route-view="pending">List Pending JD</a>
                    </div>
                </details>
                <details class="sidebar-group" @(manpowerApprovalOpen ? "open" : "")>
                    <summary class="sidebar-link sidebar-parent"><span class="sidebar-icon">✓</span><span class="sidebar-parent-label">Manpower Approval</span><span class="sidebar-chevron" aria-hidden="true"></span></summary>
                    <div class="sidebar-subnav">
                        <a class="sidebar-link sidebar-sublink" asp-page="/Approvals/Index" asp-route-view="manpower-pending">Pending Approval</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/Approvals/Index" asp-route-view="manpower-history">History Approved Request</a>
                    </div>
                </details>
                <details class="sidebar-group" @(manpowerRequestOpen ? "open" : "")>
                    <summary class="sidebar-link sidebar-parent"><span class="sidebar-icon">+</span><span class="sidebar-parent-label">Manpower Request</span><span class="sidebar-chevron" aria-hidden="true"></span></summary>
                    <div class="sidebar-subnav">
                        <a class="sidebar-link sidebar-sublink" asp-page="/Manpower/Index" asp-route-view="new-headcount">Request New Headcount</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/Manpower/Index" asp-route-view="replacement">Request Replacement</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/Manpower/Index" asp-route-view="history">History Request</a>
                    </div>
                </details>
                <a class="sidebar-link" asp-page="/Leave/Manage"><span class="sidebar-icon">▣</span>Kelola Cuti</a>
            }
            else if (isManager)
            {
                <div class="sidebar-section">People</div>
                <details class="sidebar-group" open>
                    <summary class="sidebar-link sidebar-parent"><span class="sidebar-icon">+</span><span class="sidebar-parent-label">Manpower Request</span><span class="sidebar-chevron" aria-hidden="true"></span></summary>
                    <div class="sidebar-subnav">
                        <a class="sidebar-link sidebar-sublink" asp-page="/Manpower/Index" asp-route-view="new-headcount">Request New Headcount</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/Manpower/Index" asp-route-view="replacement">Request Replacement</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/Manpower/Index" asp-route-view="history">History Request</a>
                    </div>
                </details>
                <details class="sidebar-group">
                    <summary class="sidebar-link sidebar-parent"><span class="sidebar-icon">JD</span><span class="sidebar-parent-label">Form JD</span><span class="sidebar-chevron" aria-hidden="true"></span></summary>
                    <div class="sidebar-subnav">
                        <a class="sidebar-link sidebar-sublink" asp-page="/JobDescriptions/Index" asp-route-view="input">Form Input JD</a>
                        <a class="sidebar-link sidebar-sublink" asp-page="/JobDescriptions/Index" asp-route-view="submitted">Submitted JD</a>
                    </div>
                </details>
            }

            @if (isEmployee)
            {
                <div class="sidebar-section">My HR</div>
                <a class="sidebar-link" asp-page="/Attendance/Index"><span class="sidebar-icon">◷</span>Absensi</a>
                <a class="sidebar-link" asp-page="/Leave/Index"><span class="sidebar-icon">▣</span>Cuti Saya</a>
                <a class="sidebar-link" asp-page="/FlexibleBenefits/Index"><span class="sidebar-icon">Rp</span>Flexible Benefit</a>
                <a class="sidebar-link" asp-page="/Family/Index"><span class="sidebar-icon">♧</span>Keluarga</a>
                <a class="sidebar-link" asp-page="/Booking/Index"><span class="sidebar-icon">□</span>Booking Meeting</a>
                <a class="sidebar-link" asp-page="/Letters/Index"><span class="sidebar-icon">✉</span>HR Letter</a>
                <a class="sidebar-link" asp-page="/Parking/Index"><span class="sidebar-icon">P</span>Parking</a>
                <a class="sidebar-link" asp-page="/Declarations/Index"><span class="sidebar-icon">D</span>Declaration</a>
                <a class="sidebar-link" asp-page="/Laptops/Index"><span class="sidebar-icon">L</span>Laptop</a>
            }
            else if (isHrOrSupport)
            {
                <div class="sidebar-section">HR Operations</div>
                <a class="sidebar-link" asp-page="/FlexibleBenefits/Index"><span class="sidebar-icon">Rp</span>Flexible Benefit</a>
                <a class="sidebar-link" asp-page="/Booking/Index"><span class="sidebar-icon">□</span>Booking Meeting</a>
                <a class="sidebar-link" asp-page="/ServiceAwards/Index"><span class="sidebar-icon">★</span>Service Award</a>
            }

            <div class="sidebar-section">Content</div>
            <a class="sidebar-link" asp-page="/Documents/Index"><span class="sidebar-icon">▤</span>Dokumen</a>
            <a class="sidebar-link" asp-page="/Learning/Index"><span class="sidebar-icon">L</span>Learning</a>
            <a class="sidebar-link" asp-page="/Forms/Index"><span class="sidebar-icon">F</span>HR Forms</a>
            <a class="sidebar-link" asp-page="/Regulations/Index"><span class="sidebar-icon">R</span>Regulasi</a>
            <a class="sidebar-link" asp-page="/EAP/Index"><span class="sidebar-icon">E</span>EAP</a>
            <a class="sidebar-link" asp-page="/Expatriate/Index"><span class="sidebar-icon">X</span>Expatriate</a>
            <a class="sidebar-link" asp-page="/YES/Index"><span class="sidebar-icon">Y</span>YES</a>

            <div class="sidebar-section">Performance</div>
            <a class="sidebar-link" asp-page="/Evaluations/Index"><span class="sidebar-icon">E</span>Employee Evaluation</a>
            <a class="sidebar-link" asp-page="/Performance/Index"><span class="sidebar-icon">P</span>Performance Plan</a>
            <a class="sidebar-link" asp-page="/Competencies/Index"><span class="sidebar-icon">C</span>Competency</a>
            <a class="sidebar-link" asp-page="/PersonalActions/Index"><span class="sidebar-icon">PA</span>Personal Action</a>
            @if (isHrOrSupport)
            {
                <a class="sidebar-link" asp-page="/Kpi/Criteria"><span class="sidebar-icon">K</span>Kriteria KPI</a>
                <a class="sidebar-link" asp-page="/Kpi/Periods"><span class="sidebar-icon">K</span>Periode KPI</a>
            }
            @if (isManager)
            {
                <a class="sidebar-link" asp-page="/Kpi/Review"><span class="sidebar-icon">✓</span>Review KPI</a>
            }

            <div class="sidebar-section">Account</div>
            <form method="post" asp-page="/Account/Logout" class="sidebar-logout">
                <button type="submit" class="sidebar-link sidebar-button"><span class="sidebar-icon">↪</span>Logout</button>
            </form>
        </nav>
    </aside>
    <div class="sidebar-overlay d-lg-none" id="sidebarOverlay"></div>
}

<main class="app-main @(isAuth ? "with-sidebar" : "")">
    @if (isAuth)
    {
        <header class="app-topbar">
            <button type="button" class="btn btn-light border d-lg-none" id="sidebarOpen" aria-label="Buka menu">☰</button>
            <div class="small text-muted">@ViewData["Title"]</div>
            <div class="ms-auto d-flex align-items-center gap-3">
                <a asp-page="/Notifications/Index" class="text-decoration-none text-dark">
                    Notifikasi @if(unreadCount>0){<span class="badge bg-danger">@unreadCount</span>}
                </a>
                <span class="small text-muted">@username</span>
            </div>
        </header>
    }

    <div class="app-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="text-center text-muted my-5 small">
        HRIS &middot; .NET 8 + Razor Pages
    </footer>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    var sidebar = document.getElementById('appSidebar');
    var overlay = document.getElementById('sidebarOverlay');
    var open = document.getElementById('sidebarOpen');
    var close = document.getElementById('sidebarClose');
    function show() {
        if (!sidebar) return;
        sidebar.classList.add('is-open');
        if (overlay) overlay.classList.add('is-visible');
        document.body.classList.add('sidebar-open');
    }
    function hide() {
        if (!sidebar) return;
        sidebar.classList.remove('is-open');
        if (overlay) overlay.classList.remove('is-visible');
        document.body.classList.remove('sidebar-open');
    }
    if (open) open.addEventListener('click', show);
    if (close) close.addEventListener('click', hide);
    if (overlay) overlay.addEventListener('click', hide);
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

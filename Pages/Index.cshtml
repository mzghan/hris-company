@page
@model HRIS.Api.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="mb-1">Halo, @Model.Username 👋</h3>
<p class="text-muted mb-4">Role kamu: <span class="badge bg-secondary">@Model.Role</span></p>

<div class="row g-3">
    @if (Model.IsHrOrSupport)
    {
        <div class="col-md-4">
            <div class="card p-3">
                <div class="text-muted small">Total Karyawan</div>
                <div class="fs-3 fw-bold">@Model.TotalEmployees</div>
                <a asp-page="/Employees/Index" class="small">Kelola karyawan &rarr;</a>
            </div>
        </div>
    }

    @if (Model.CanApprove || Model.PendingApprovals > 0)
    {
        <div class="col-md-4">
            <div class="card p-3">
                <div class="text-muted small">Pengajuan Menunggu Approval Kamu</div>
                <div class="fs-3 fw-bold">@Model.PendingApprovals</div>
                <a asp-page="/Approvals/Index" class="small">Lihat & tindak lanjuti &rarr;</a>
            </div>
        </div>
    }

    @if (Model.HasEmployeeProfile)
    {
        <div class="col-md-4">
            <div class="card p-3">
                <div class="text-muted small">Absensi Hari Ini</div>
                <div class="fs-5 fw-bold">
                    @if (Model.CheckedOutToday)
                    {
                        <span class="text-success">Sudah check-in & check-out</span>
                    }
                    else if (Model.CheckedInToday)
                    {
                        <span class="text-warning">Sudah check-in, belum check-out</span>
                    }
                    else
                    {
                        <span class="text-muted">Belum absen</span>
                    }
                </div>
                <a asp-page="/Attendance/Index" class="small">Buka absensi &rarr;</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3">
                <div class="text-muted small">Pengajuan Cuti Saya (Pending)</div>
                <div class="fs-3 fw-bold">@Model.MyPendingLeaveCount</div>
                <a asp-page="/Leave/Index" class="small">Lihat / ajukan cuti &rarr;</a>
            </div>
        </div>
    }
    else if (!Model.IsHrOrSupport)
    {
        <div class="col-12">
            <div class="alert alert-warning">
                Akun kamu belum terhubung ke data Employee, jadi fitur absensi & cuti belum bisa dipakai.
                Hubungi Admin untuk menautkan akun ini ke data Employee.
            </div>
        </div>
    }
</div>

<div class="row g-3 mt-1">
    @if (Model.HasEmployeeProfile)
    {
        <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Employee Evaluation</div><div class="fw-semibold">Evaluasi probation & contract</div><a asp-page="/Evaluations/Index" class="small">Buka evaluasi &rarr;</a></div></div>
        <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Performance</div><div class="fw-semibold">Plan, task & work log</div><a asp-page="/Performance/Index" class="small">Buka performance &rarr;</a></div></div>
        <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Competency</div><div class="fw-semibold">Target & self-assessment</div><a asp-page="/Competencies/Index" class="small">Buka competency &rarr;</a></div></div>
        <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Personal Action</div><div class="fw-semibold">PAF perubahan data pekerjaan</div><a asp-page="/PersonalActions/Index" class="small">Buka PAF &rarr;</a></div></div>
    }
    @if (Model.HasEmployeeProfile)
    {
        <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Flexible Benefit</div><div class="fw-semibold">Saldo &amp; klaim</div><a asp-page="/FlexibleBenefits/Index" class="small">Buka Flexible Benefit &rarr;</a></div></div>
        <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Meeting</div><div class="fw-semibold">Booking meeting room</div><a asp-page="/Booking/Index" class="small">Lihat jadwal &rarr;</a></div></div>
    }
    @if (Model.CanApprove || Model.IsHrOrSupport)
    {
        <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Workforce</div><div class="fw-semibold">Manpower Request</div><a asp-page="/Manpower/Index" class="small">Kelola pengajuan &rarr;</a></div></div>
    }

    <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Learning</div><div class="fw-semibold">My Learning Portal</div><a asp-page="/Learning/Index" class="small">Buka portal &rarr;</a></div></div>
    <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">HR Forms</div><div class="fw-semibold">Formulir HR</div><a asp-page="/Forms/Index" class="small">Lihat formulir &rarr;</a></div></div>
    <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Regulation</div><div class="fw-semibold">Peraturan perusahaan</div><a asp-page="/Regulations/Index" class="small">Baca regulasi &rarr;</a></div></div>
    <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">EAP</div><div class="fw-semibold">Employee Assistance Program</div><a asp-page="/EAP/Index" class="small">Ajukan bantuan &rarr;</a></div></div>
    <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">Expatriate</div><div class="fw-semibold">Dokumen ekspatriat</div><a asp-page="/Expatriate/Index" class="small">Buka portal &rarr;</a></div></div>
    <div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted small">YES</div><div class="fw-semibold">Portal YES</div><a asp-page="/YES/Index" class="small">Buka YES &rarr;</a></div></div>
</div>

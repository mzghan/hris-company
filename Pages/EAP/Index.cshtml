@page
@model HRIS.Api.Pages.EAP.IndexModel
@{
    ViewData["Title"] = "EAP";
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card p-3">
            <h5>Employee Assistance Program</h5>
            <p class="text-muted small">Sampaikan kebutuhan bantuan kepada HR. Kamu dapat mengirim tanpa mencantumkan identitas.</p>
            <form method="post" asp-page-handler="Create">
                <div class="mb-2"><label class="form-label small">Kategori</label><select name="category" class="form-select" required><option value="Personal">Personal</option><option value="Family">Family</option><option value="Work">Work</option><option value="Financial">Financial</option><option value="Other">Other</option></select></div>
                <div class="mb-2"><label class="form-label small">Cerita / kebutuhan bantuan</label><textarea name="description" class="form-control" rows="7" required maxlength="4000"></textarea></div>
                <div class="form-check mb-3"><input name="isAnonymous" value="true" class="form-check-input" type="checkbox" id="anonymous" /><label class="form-check-label" for="anonymous">Kirim sebagai anonim</label></div>
                <button class="btn btn-primary">Kirim ke HR</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-3">
            <h6 class="mb-3">@(Model.CanManage ? "Permintaan EAP" : "Pengajuan Saya")</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Tanggal</th><th>Pengaju</th><th>Kategori</th><th>Isi</th><th>Status</th>@if (Model.CanManage){<th>Aksi</th>}</tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="small">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.IsAnonymous ? "Anonim" : item.EmployeeName)</td>
                            <td>@item.Category</td>
                            <td style="max-width:260px; white-space:pre-wrap;">@item.Description</td>
                            <td><span class="status-@item.Status">@item.Status</span></td>
                            @if (Model.CanManage)
                            {
                                <td>
                                    <form method="post" asp-page-handler="Status" class="d-flex gap-1">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <select name="status" class="form-select form-select-sm"><option selected="@(item.Status == "Pending")" value="Pending">Pending</option><option selected="@(item.Status == "InProgress")" value="InProgress">In Progress</option><option selected="@(item.Status == "Resolved")" value="Resolved">Resolved</option><option selected="@(item.Status == "Closed")" value="Closed">Closed</option></select>
                                        <button class="btn btn-sm btn-outline-primary">Simpan</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                    @if (!Model.Items.Any()) { <tr><td colspan="6" class="text-center text-muted py-4">Belum ada permintaan.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

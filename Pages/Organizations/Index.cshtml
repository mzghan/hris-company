@page
@model HRIS.Api.Pages.Organizations.IndexModel
@{
    ViewData["Title"] = "Organisasi";
}

<h4 class="mb-3">Struktur Organisasi</h4>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3">
            <h6>Tambah Organisasi</h6>
            <form method="post" asp-page-handler="Create">
                <div class="mb-2">
                    <input asp-for="NewOrganization.Name" class="form-control" placeholder="Nama organisasi" />
                    <span asp-validation-for="NewOrganization.Name" class="text-danger small"></span>
                </div>
                <div class="mb-2">
                    <select asp-for="NewOrganization.ParentId" asp-items="Model.ParentOptions" class="form-select">
                        <option value="">-- Organisasi paling atas --</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100">Tambah</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-3">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nama</th>
                        <th>Level</th>
                        <th>Karyawan</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Organizations)
                    {
                        <tr>
                            <td style="min-width: 220px; padding-left: @((o.OrganizationLevel - 1) * 20 + 8)px;">
                                <form method="post" asp-page-handler="Rename" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <input type="text" name="name" value="@o.OrganizationName" class="form-control form-control-sm" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Simpan</button>
                                </form>
                            </td>
                            <td>@o.OrganizationLevel</td>
                            <td>@o.EmployeeCount</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@o.Id" onsubmit="return confirm('Hapus organisasi @o.OrganizationName?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Organizations.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">Belum ada organisasi.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@page
@model HRIS.Api.Pages.PersonalActions.IndexModel
@{ViewData["Title"]="Personal Action";}
<div class="page-heading"><div><div class="text-muted small">Modul 14</div><h4 class="mb-1">Personal Action (PAF)</h4><p class="text-muted mb-0">Perubahan grade, jabatan, organisasi, lokasi, atau atasan dengan riwayat tetap terjaga.</p></div></div>
<div class="card p-3 mb-3"><h6>Pengajuan PAF</h6><form method="post" class="row g-2"><div class="col-md-3">@if(Model.IsHrOrSupport){<label class="form-label small">Karyawan</label><select asp-for="EmployeeId" class="form-select form-select-sm"><option value="">Pilih</option>@foreach(var e in Model.Employees.Where(x=>x.IsActive)){<option value="@e.Id">@e.EmployeeNumber - @e.FullName</option>}</select>}else{<label class="form-label small">Karyawan</label><input value="@Model.Employees.FirstOrDefault(x=>x.Id==Model.EmployeeId)?.FullName" class="form-control form-control-sm" disabled/>}</div><div class="col-md-2"><label class="form-label small">Action</label><select asp-for="ActionType" class="form-select form-select-sm"><option>Transfer</option><option>GradeChange</option><option>InfoChange</option></select></div><div class="col-md-2"><label class="form-label small">Effective Date</label><input asp-for="EffectiveDate" type="date" class="form-control form-control-sm"/></div><div class="col-md-5"><label class="form-label small">Alasan</label><input asp-for="Reason" class="form-control form-control-sm"/></div>
<div class="col-md-4"><label class="form-label small">Organisasi</label><select asp-for="NewOrganizationId" class="form-select form-select-sm"><option value="">Tidak berubah</option>@foreach(var x in Model.Organizations){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-4"><label class="form-label small">Jabatan</label><select asp-for="NewJobTitleId" class="form-select form-select-sm"><option value="">Tidak berubah</option>@foreach(var x in Model.JobTitles){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-2"><label class="form-label small">Job Level</label><select asp-for="NewJobLevelId" class="form-select form-select-sm"><option value="">Tidak berubah</option>@foreach(var x in Model.JobLevels){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-2"><label class="form-label small">Grade</label><select asp-for="NewGradeId" class="form-select form-select-sm"><option value="">Tidak berubah</option>@foreach(var x in Model.Grades){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-4"><label class="form-label small">Lokasi</label><select asp-for="NewLocationId" class="form-select form-select-sm"><option value="">Tidak berubah</option>@foreach(var x in Model.Locations){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-4"><label class="form-label small">Manager Baru</label><select asp-for="NewManagerId" class="form-select form-select-sm"><option value="">Tidak berubah</option>@foreach(var e in Model.Employees.Where(x=>x.IsActive)){<option value="@e.Id">@e.FullName</option>}</select></div>
<div class="col-12"><button class="btn btn-primary btn-sm">Ajukan PAF</button></div></form></div>
<div class="card p-3"><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Karyawan</th><th>Action</th><th>Efektif</th><th>Perubahan</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.EmployeeName</td><td>@x.ActionType</td><td>@x.EffectiveDate.ToString("dd MMM yyyy")</td><td class="small">@x.NewOrganizationName @x.NewJobTitleName @x.NewJobLevelName @if(x.NewGradeLevel is not null){<span>Grade @x.NewGradeLevel</span>} @x.NewLocationName @if(x.NewManagerName is not null){<span>Manager: @x.NewManagerName</span>}</td><td><span class="status-@x.Status">@x.Status</span></td><td>@if(x.ApprovalId is not null){<a asp-page="/Approvals/Index" class="small">Approval</a>}</td></tr>}@if(!Model.Items.Any()){<tr><td colspan="6" class="text-center text-muted py-4">Belum ada PAF.</td></tr>}</tbody></table></div></div>
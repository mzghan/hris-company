@page
@model HRIS.Api.Pages.Laptops.IndexModel
@{ ViewData["Title"] = "Laptop Ownership"; }
<div class="row g-3"><div class="col-lg-4"><div class="card p-3"><h6>Permintaan Laptop</h6><form method="post" asp-page-handler="Create"><div class="mb-2"><label class="form-label small">Model</label><input name="model" class="form-control" maxlength="200" required /></div><div class="mb-3"><label class="form-label small">Harga (rupiah)</label><input name="price" type="number" min="0" class="form-control" /></div><button class="btn btn-primary">Ajukan</button></form></div></div><div class="col-lg-8"><div class="card p-3"><h6 class="mb-3">Permintaan Laptop</h6><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Pengaju</th><th>Model</th><th>Harga</th><th>Status</th>@if(Model.CanManage){<th>Aksi</th>}</tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.EmployeeName</td><td>@x.Model<br/><span class="small text-muted">Asset: @(x.AssetTag??"-")</span></td><td>@(x.Price?.ToString("N0")??"-")</td><td><span class="status-@x.Status">@x.Status</span></td>@if(Model.CanManage){<td>@if(x.Status=="Submitted"){<form method="post" asp-page-handler="Status" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="status" value="ForwardedToIT"/><button class="btn btn-sm btn-outline-primary">Forward IT</button></form>}else if(x.Status=="Approved"){<form method="post" asp-page-handler="Status" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="status" value="Purchased"/><button class="btn btn-sm btn-outline-primary">Tandai Purchased</button></form>}else if(x.Status=="Purchased"){<form method="post" asp-page-handler="Status" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="status" value="ResetDone"/><button class="btn btn-sm btn-outline-success">Reset Selesai</button></form>}else{<span class="small text-muted">-</span>}</td>}</tr>}@if(!Model.Items.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Belum ada permintaan.</td></tr>}</tbody></table></div></div></div></div>

@page
@model HRIS.Api.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departemen";
}

<h4 class="mb-3">Data Departemen</h4>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3">
            <h6>Tambah Departemen</h6>
            <form method="post" asp-page-handler="Create">
                <div class="mb-2">
                    <input asp-for="NewDepartment.Name" class="form-control" placeholder="Nama departemen" />
                    <span asp-validation-for="NewDepartment.Name" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100">Tambah</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-3">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nama</th>
                        <th>Jumlah Karyawan</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Departments)
                    {
                        <tr>
                            <td style="min-width: 200px;">
                                <form method="post" asp-page-handler="Rename" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <input type="text" name="name" value="@d.Name" class="form-control form-control-sm" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Simpan</button>
                                </form>
                            </td>
                            <td>@d.EmployeeCount</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@d.Id" onsubmit="return confirm('Hapus departemen @d.Name?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Departments.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted py-3">Belum ada departemen.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

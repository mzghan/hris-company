@page
@model HRIS.Api.Pages.Evaluations.IndexModel
@{ViewData["Title"]="Employee Evaluation";}
<div class="page-heading"><div><div class="text-muted small">Modul 11</div><h4 class="mb-1">Employee Evaluation</h4><p class="text-muted mb-0">Evaluasi probation dan contract berdasarkan employment aktif.</p></div></div>
<div class="card p-3"><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Karyawan</th><th>Jenis</th><th>Due Date</th><th>Status</th><th>Catatan</th><th>Nilai</th></tr></thead><tbody>
@foreach(var x in Model.Items){<tr><td class="fw-semibold">@x.EmployeeName</td><td>@x.EvaluationTypeName</td><td>@x.DueDate.ToString("dd MMM yyyy")</td><td><span class="status-@x.Status">@x.Status</span></td><td><div class="small">@foreach(var e in x.Entries.Take(2)){<div class="mb-1">• @e.WorkDescription</div>}<form method="post" asp-page-handler="Entry" asp-route-id="@x.Id" class="d-flex gap-1 mt-2"><input name="EntryText" class="form-control form-control-sm" placeholder="Tambah catatan..." /><button class="btn btn-sm btn-outline-primary">Tambah</button></form></div></td><td><div class="small">@foreach(var s in x.Scores.Take(3)){<div>@s.Score/100 <span class="text-muted">(@s.ScoredByUsername)</span></div>}@if(Model.CanScore){<form method="post" asp-page-handler="Score" asp-route-id="@x.Id" class="d-flex gap-1 mt-2"><input name="Score" type="number" min="0" max="100" class="form-control form-control-sm" style="width:80px" placeholder="0-100"/><input name="ScoreNote" class="form-control form-control-sm" placeholder="Catatan"/><button class="btn btn-sm btn-success">Nilai</button></form>}</div></td></tr>}
@if(!Model.Items.Any()){<tr><td colspan="6" class="text-center text-muted py-4">Belum ada evaluasi.</td></tr>}</tbody></table></div></div>
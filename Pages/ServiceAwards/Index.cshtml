@page
@model HRIS.Api.Pages.ServiceAwards.IndexModel
@{ ViewData["Title"] = "Service Award"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h4>Service Award</h4><p class="text-muted small mb-0">Milestone masa kerja dibuat pada kelipatan 5 tahun berdasarkan join date.</p></div></div><div class="card p-3"><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Karyawan</th><th>Masa Kerja</th><th>Due Date</th><th>Status</th><th>Aksi</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.EmployeeName</td><td>@x.ServiceYears tahun</td><td>@x.DueDate.ToString("dd/MM/yyyy")</td><td><span class="status-@x.Status">@x.Status</span></td><td>@if(x.Status=="Pending"){<form method="post" asp-page-handler="Status" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="status" value="Reminded"/><button class="btn btn-sm btn-outline-primary">Tandai Reminded</button></form>}else if(x.Status=="Reminded"){<form method="post" asp-page-handler="Status" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="status" value="Given"/><button class="btn btn-sm btn-outline-success">Tandai Given</button></form>}else{<span class="text-muted small">@x.GivenAt?.ToLocalTime().ToString("dd/MM/yyyy")</span>}</td></tr>}@if(!Model.Items.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Belum ada milestone.</td></tr>}</tbody></table></div></div>

@page
@model HRIS.Api.Pages.JobDescriptions.IndexModel
@{ViewData["Title"]="Job Description";}
<div class="page-heading"><div><div class="text-muted small">HRManpower / Job Description</div><h4 class="mb-1">@((Model.View ?? "input") switch { "input" => "Form Input JD", "submitted" => "Submitted JD", "pending" => "List Pending JD", "bank" => "List Bank JD", "bank-signature" => "List Bank JD with Signature", "sign-job-holder" => "Sign JD as Job Holder", "sign-manager" => "Sign JD as Immediate Manager", _ => "Job Description" })</h4><p class="text-muted mb-0">Kelola JD dari input, approval, signing sampai bank JD.</p></div></div>
@if(Model.CanCreate && (Model.View == null || Model.View == "input")){
<div class="card p-3 mb-3"><h6>Form Input JD</h6><div asp-validation-summary="ModelOnly" class="text-danger small"></div>
<form method="post" class="row g-2">
<div class="col-md-4"><label class="form-label small">Job Title</label><input asp-for="Input.JobTitle" class="form-control form-control-sm"/></div>
<div class="col-md-3"><label class="form-label small">Organization</label><select asp-for="Input.OrganizationId" class="form-select form-select-sm"><option value="">-</option>@foreach(var x in Model.Organizations){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-2"><label class="form-label small">Job Level</label><select asp-for="Input.JobLevelId" class="form-select form-select-sm"><option value="">-</option>@foreach(var x in Model.JobLevels){<option value="@x.Id">@x.Name</option>}</select></div>
<div class="col-md-3"><label class="form-label small">Job Holder</label><select asp-for="Input.JobHolderEmployeeId" class="form-select form-select-sm"><option value="">-</option>@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select></div><div class="col-md-3"><label class="form-label small">Immediate Manager</label><select asp-for="Input.ImmediateManagerEmployeeId" class="form-select form-select-sm"><option value="">-</option>@foreach(var e in Model.Employees){<option value="@e.Id">@e.FullName</option>}</select></div><div class="col-md-2"><label class="form-label small">Grade</label><select asp-for="Input.GradeId" class="form-select form-select-sm"><option value="">-</option>@foreach(var x in Model.Grades){<option value="@x.Id">@x.Name</option>}</select></div>
@foreach(var f in new[]{("Purpose","Purpose"),("ReportingRelationship","Reporting Relationship"),("Dimensions","Dimensions"),("KriCico","KRA CICO"),("KriCompliance","KRA Compliance"),("KriAreas","KRA / KPI"),("Stakeholders","Stakeholders"),("Challenges","Challenges"),("Qualifications","Qualifications"),("Experience","Experience"),("Competencies","Competencies")}){<div class="col-md-6"><label class="form-label small">@(f.Item2)</label><textarea name="Input.@(f.Item1)" class="form-control form-control-sm" rows="2"></textarea></div>}
<div class="col-12 d-flex gap-2"><button name="submit" value="false" class="btn btn-outline-primary btn-sm">Save Draft</button><button name="submit" value="true" class="btn btn-primary btn-sm">Submit JD</button></div>
</form></div>}
<div class="card p-3"><h6>JD Bank / History</h6><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Code</th><th>Job Title</th><th>Organization</th><th>Level</th><th>Status</th><th>Approval</th><th></th></tr></thead><tbody>
@foreach(var x in Model.Items.Where(x => Model.View switch { "submitted" => x.Status != "Draft", "pending" => x.ApprovalFlag >= 0 && x.ApprovalFlag < 4, "bank-signature" => x.ApprovalFlag == 7, "bank" => x.ApprovalFlag == 7, _ => true })) {<tr><td>@x.Code</td><td>@x.JobTitle</td><td>@x.OrganizationName</td><td>@x.JobLevelName</td><td>@x.Status</td><td>@x.ApprovalFlag</td><td class="text-nowrap"><a asp-page="/JobDescriptions/Print" asp-route-id="@x.Id">Print</a>
@if(x.ApprovalFlag == 5 && string.IsNullOrWhiteSpace(x.JobHolderSignatureText)){ <a class="ms-2" asp-page="/JobDescriptions/Sign" asp-route-id="@x.Id" asp-route-mode="job-holder">Sign Holder</a> }
@if(x.ApprovalFlag == 6 && string.IsNullOrWhiteSpace(x.ManagerSignatureText)){ <a class="ms-2" asp-page="/JobDescriptions/Sign" asp-route-id="@x.Id" asp-route-mode="manager">Sign Manager</a> }</td></tr>}
@if(!Model.Items.Any()){<tr><td colspan="7" class="text-center text-muted">Belum ada JD.</td></tr>}</tbody></table></div></div>

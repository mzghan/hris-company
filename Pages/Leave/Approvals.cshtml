@page
@model HRIS.Api.Pages.Leave.ApprovalsModel
@{
    ViewData["Title"] = "Approval Cuti";
}

<h4 class="mb-3">Cuti Menunggu Persetujuan Kamu</h4>

@if (Model.AccountNotLinkedToEmployee)
{
    <div class="alert alert-info">
        Akun ini belum terhubung ke data Employee, jadi tidak ada approval cuti yang bisa ditampilkan
        di sini. Ini normal untuk akun Admin yang tidak berperan sebagai atasan langsung siapa pun.
    </div>
}
else
{
<div class="card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Karyawan</th>
                <th>Periode</th>
                <th>Alasan</th>
                <th>Level</th>
                <th class="text-end">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Pending)
            {
                <tr>
                    <td>@r.EmployeeName</td>
                    <td>@r.StartDate.ToString("dd MMM yyyy") - @r.EndDate.ToString("dd MMM yyyy")</td>
                    <td>@(r.Reason ?? "-")</td>
                    <td>@r.CurrentLevel</td>
                    <td class="text-end">
                        <details class="d-inline-block text-start">
                            <summary class="btn btn-sm btn-outline-secondary">Tindak Lanjuti</summary>
                            <div class="border rounded p-2 mt-2" style="min-width: 260px;">
                                <form method="post" asp-page-handler="Approve" asp-route-id="@r.Id" class="mb-2">
                                    <textarea name="note" class="form-control form-control-sm mb-1" placeholder="Catatan (opsional)"></textarea>
                                    <button type="submit" class="btn btn-success btn-sm w-100">Setujui</button>
                                </form>
                                <form method="post" asp-page-handler="Reject" asp-route-id="@r.Id">
                                    <textarea name="note" class="form-control form-control-sm mb-1" placeholder="Catatan (opsional)"></textarea>
                                    <button type="submit" class="btn btn-danger btn-sm w-100">Tolak</button>
                                </form>
                            </div>
                        </details>
                    </td>
                </tr>
            }
            @if (!Model.Pending.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-3">Tidak ada cuti yang menunggu persetujuan kamu.</td></tr>
            }
        </tbody>
    </table>
</div>
}

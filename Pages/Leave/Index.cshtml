@page
@model HRIS.Api.Pages.Leave.IndexModel
@{
    ViewData["Title"] = "Cuti Saya";
}

<h4 class="mb-3">Pengajuan Cuti Saya</h4>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3">
            <h6>Ajukan Cuti Baru</h6>
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <form method="post">
                <div class="mb-2">
                    <label class="form-label small">Jenis Cuti</label>
                    <select asp-for="Input.LeaveTypeId" class="form-select form-select-sm">
                        <option value="">Pilih jenis cuti</option>
                        @foreach (var type in Model.LeaveTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Tanggal Mulai</label>
                    <input asp-for="Input.StartDate" type="date" class="form-control form-control-sm" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Tanggal Selesai</label>
                    <input asp-for="Input.EndDate" type="date" class="form-control form-control-sm" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Alasan</label>
                    <textarea asp-for="Input.Reason" class="form-control form-control-sm" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100">Ajukan</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-3">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Periode</th>
                        <th>Hari Kerja</th>
                        <th>Alasan</th>
                        <th>Status</th>
                        <th>Persetujuan</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.MyRequests)
                    {
                        <tr>
                            <td>@r.StartDate.ToString("dd MMM yyyy") - @r.EndDate.ToString("dd MMM yyyy")</td>
                            <td>@r.Days</td>
                            <td>@(r.Reason ?? "-")</td>
                            <td><span class="status-@r.Status">@r.Status</span></td>
                            <td>
                                <ul class="list-unstyled small mb-0">
                                    @foreach (var a in r.Approvals)
                                    {
                                        <li>@a.Level. @a.ApproverName <span class="status-@a.Status">@a.Status</span></li>
                                    }
                                </ul>
                            </td>
                            <td class="text-end">
                                @if (r.Status == "Pending")
                                {
                                    <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id" onsubmit="return confirm('Batalkan pengajuan cuti ini?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Batalkan</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.MyRequests.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Belum ada pengajuan cuti.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card p-3 mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h6 class="mb-0">Saldo Cuti @Model.SelectedYear</h6>
            <div class="small text-muted">Hari kerja, setelah memperhitungkan penggunaan dan penjualan cuti.</div>
        </div>
        <a asp-page="/FlexibleBenefits/Index" class="btn btn-sm btn-outline-primary">Flexible Benefit</a>
    </div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>Jenis</th><th>Entitlement</th><th>Terpakai</th><th>Dijual</th><th>Carry Over</th><th>Tersedia</th></tr></thead>
            <tbody>
            @foreach (var b in Model.Balances)
            {
                <tr>
                    <td>@b.LeaveType?.Name</td>
                    <td>@b.Entitlement</td>
                    <td>@b.Used</td>
                    <td>@b.Sold</td>
                    <td>@b.CarriedOver</td>
                    <td class="fw-semibold">@(b.Entitlement + b.CarriedOver - b.Used - b.Sold)</td>
                </tr>
            }
            @if (!Model.Balances.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-3">Belum ada saldo cuti.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

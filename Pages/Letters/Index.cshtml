@page
@model HRIS.Api.Pages.Letters.IndexModel
@{ ViewData["Title"] = "HR Letter"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h4 class="mb-1">HR Letter</h4><p class="text-muted small mb-0">Permintaan surat diproses melalui approval HR.</p></div></div>
<div class="row g-3"><div class="col-lg-4"><div class="card p-3"><h6>Ajukan Surat</h6><form method="post" asp-page-handler="Create"><div class="mb-2"><label class="form-label small">Jenis surat</label><select name="letterTypeId" class="form-select" required>@foreach(var t in Model.Types){<option value="@t.Id">@t.Name</option>}</select></div><div class="mb-2"><label class="form-label small">Keperluan</label><textarea name="purpose" class="form-control" rows="4" maxlength="500" required></textarea></div><div class="mb-3"><label class="form-label small">Tujuan</label><input name="destination" class="form-control" maxlength="300" placeholder="Opsional" /></div><button class="btn btn-primary">Ajukan</button></form></div>@if(Model.CanManage){<div class="card p-3 mt-3"><h6>Jenis Surat</h6><form method="post" asp-page-handler="SaveType"><input name="id" type="hidden" value="0"/><input name="name" class="form-control mb-2" placeholder="Nama jenis surat" required/><input name="templateDocumentId" type="number" class="form-control mb-2" placeholder="ID template dokumen (opsional)"/><button class="btn btn-sm btn-outline-primary">Tambah Jenis</button></form></div>}</div><div class="col-lg-8"><div class="card p-3"><h6 class="mb-3">Pengajuan Surat</h6><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Pengaju</th><th>Jenis</th><th>Keperluan</th><th>Status</th><th>Dokumen</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.EmployeeName</td><td>@x.LetterTypeName</td><td>@x.Purpose<br/><span class="small text-muted">@x.Destination</span></td><td><span class="status-@x.Status">@x.Status</span></td><td>@if(x.IssuedDocumentId is int d){<a asp-page="/Documents/Index" asp-page-handler="Download" asp-route-id="@d">Buka</a>}else if(Model.CanManage&&x.Status=="Approved"){<span class="small text-muted">Upload hasil surat di Dokumen, lalu isi ID saat menerbitkan via API.</span>}else{<span>-</span>}</td></tr>}@if(!Model.Items.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Belum ada pengajuan.</td></tr>}</tbody></table></div></div></div></div>

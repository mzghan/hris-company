@page
@model HRIS.Api.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Karyawan";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Data Karyawan</h4>
    <a asp-page="/Employees/Create" class="btn btn-primary btn-sm">+ Tambah Karyawan</a>
</div>

<div class="card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>NIK</th>
                <th>Nama</th>
                <th>Email</th>
                <th>Jabatan</th>
                <th>Organisasi</th>
                <th>Atasan</th>
                <th>Status</th>
                <th class="text-end">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Employees)
            {
                <tr>
                    <td>@e.EmployeeNumber</td>
                    <td>@e.FullName</td>
                    <td>@(e.WorkEmail ?? "-")</td>
                    <td>@(e.JobTitleName ?? "-")</td>
                    <td>@(e.OrganizationName ?? "-")</td>
                    <td>@(e.DirectManagerName ?? "-")</td>
                    <td>
                        @if (e.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nonaktif</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-page="/Employees/Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-page="/Employees/CreateAccount" asp-route-employeeId="@e.Id" class="btn btn-sm btn-outline-primary">Buat Akun</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@e.Id" class="d-inline" onsubmit="return confirm('Hapus karyawan @e.FullName?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Employees.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-3">Belum ada data karyawan.</td></tr>
            }
        </tbody>
    </table>
</div>

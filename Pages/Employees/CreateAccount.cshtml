@page
@model HRIS.Api.Pages.Employees.CreateAccountModel
@{
    ViewData["Title"] = "Buat Akun";
}

<h4 class="mb-3">Buat Akun Login</h4>
<p class="text-muted">Untuk karyawan: <strong>@Model.EmployeeName</strong></p>

<div class="card p-4" style="max-width: 500px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form method="post">
        <input type="hidden" asp-for="EmployeeId" />
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input asp-for="Input.Username" class="form-control" />
            <span asp-validation-for="Input.Username" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input asp-for="Input.Password" type="password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Role</label>
            <select asp-for="Input.Role" class="form-select">
                <option value="Employee">Employee</option>
                <option value="Manager">Manager</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Buat Akun</button>
        <a asp-page="/Employees/Index" class="btn btn-link">Batal</a>
    </form>
</div>

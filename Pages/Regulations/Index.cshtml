@page
@model HRIS.Api.Pages.Regulations.IndexModel
@{
    ViewData["Title"] = "HR Regulation";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h4 class="mb-1">HR Regulation</h4><div class="text-muted small">Peraturan dan kebijakan perusahaan.</div></div>
</div>

<div class="accordion" id="regulations">
@foreach (var item in Model.Items)
{
    <div class="accordion-item">
        <h2 class="accordion-header" id="heading-@item.Id">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id">@item.Title</button>
        </h2>
        <div id="collapse-@item.Id" class="accordion-collapse collapse" data-bs-parent="#regulations">
            <div class="accordion-body">
                <div class="regulation-content">@item.Content</div>
                @if (Model.CanManage)
                {
                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#edit-@item.Id">Edit</button>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Nonaktifkan peraturan ini?');"><button class="btn btn-sm btn-outline-danger">Hapus</button></form>
                    </div>
                    <div class="collapse mt-3" id="edit-@item.Id">
                        <form method="post" asp-page-handler="Save">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input name="title" class="form-control mb-2" value="@item.Title" required />
                            <input name="sortOrder" type="number" class="form-control mb-2" value="@item.SortOrder" />
                            <textarea name="content" class="form-control mb-2" rows="8" required>@item.Content</textarea>
                            <button class="btn btn-primary btn-sm">Simpan perubahan</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
}
@if (!Model.Items.Any()) { <div class="card p-4 text-center text-muted">Belum ada peraturan aktif.</div> }
</div>

@if (Model.CanManage)
{
    <div class="card p-3 mt-4">
        <h6>Tambah Peraturan</h6>
        <form method="post" asp-page-handler="Save">
            <input type="hidden" name="id" value="0" />
            <div class="row g-2 mb-2"><div class="col-md-8"><input name="title" class="form-control" placeholder="Judul" required /></div><div class="col-md-4"><input name="sortOrder" type="number" class="form-control" placeholder="Urutan" value="0" /></div></div>
            <textarea name="content" class="form-control mb-2" rows="8" placeholder="Isi peraturan" required></textarea>
            <button class="btn btn-primary">Simpan</button>
        </form>
    </div>
}

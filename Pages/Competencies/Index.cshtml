@page
@model HRIS.Api.Pages.Competencies.IndexModel
@{ViewData["Title"]="Competency";}
<div class="page-heading"><div><div class="text-muted small">Modul 13</div><h4 class="mb-1">Competency</h4><p class="text-muted mb-0">Target kompetensi dan self-assessment karyawan.</p></div></div>
@if(Model.CanAssign){<div class="card p-3 mb-3"><h6>Tetapkan Kompetensi</h6><form method="post" asp-page-handler="Assign" class="row g-2"><div class="col-md-4"><select asp-for="EmployeeId" class="form-select form-select-sm"><option value="">Karyawan</option>@foreach(var e in Model.Employees.Where(x=>x.IsActive)){<option value="@e.Id">@e.EmployeeNumber - @e.FullName</option>}</select></div><div class="col-md-3"><select asp-for="CompetencyId" class="form-select form-select-sm"><option value="">Kompetensi</option>@foreach(var c in Model.Competencies){<option value="@c.Id">@c.Name</option>}</select></div><div class="col-md-2"><select asp-for="TargetLevel" class="form-select form-select-sm">@for(var i=1;i<=5;i++){<option value="@i">Target @i</option>}</select></div><div class="col-md-2"><button class="btn btn-primary btn-sm">Tetapkan</button></div></form></div>}
<div class="card p-3"><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Karyawan</th><th>Kompetensi</th><th>Target</th><th>Assessment</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.EmployeeName</td><td><div class="fw-semibold">@x.CompetencyName</div></td><td><span class="badge text-bg-light">@x.TargetLevel / 5</span></td><td>@foreach(var a in x.Assessments.Take(3)){<div class="small">@a.SelfLevel/5 — @a.Note</div>}@if(!x.Assessments.Any()){<span class="text-muted small">Belum ada</span>}</td><td><form method="post" asp-page-handler="Assess" class="d-flex gap-1"><input type="hidden" name="EmployeeCompetencyId" value="@x.Id"/><select name="SelfLevel" class="form-select form-select-sm" style="width:80px">@for(var i=1;i<=5;i++){<option value="@i">@i</option>}</select><input name="Note" class="form-control form-control-sm" placeholder="Catatan"/><button class="btn btn-sm btn-outline-success">Simpan</button></form></td></tr>}@if(!Model.Items.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Belum ada kompetensi karyawan.</td></tr>}</tbody></table></div></div>
@page
@model HRIS.Api.Pages.Kpi.PeriodsModel
@{
    ViewData["Title"] = "Periode KPI";
}

<h4 class="mb-3">Periode Penilaian KPI</h4>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3">
            <h6>Buat Periode Baru</h6>
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <form method="post" asp-page-handler="Create">
                <div class="mb-2">
                    <label class="form-label small">Nama Periode</label>
                    <input asp-for="Input.Name" class="form-control form-control-sm" placeholder="mis. Q1 2027" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Tahun</label>
                    <input asp-for="Input.Year" type="number" class="form-control form-control-sm" />
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100">Buat Periode</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-3">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nama</th>
                        <th>Tahun</th>
                        <th>Status</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Periods)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.Year</td>
                            <td><span class="status-@p.Status">@p.Status</span></td>
                            <td class="text-end">
                                <a asp-page="/Kpi/FillScores" asp-route-periodId="@p.Id" class="btn btn-sm btn-outline-primary">Isi Nilai</a>
                                @if (p.Status != "Finalized")
                                {
                                    <form method="post" asp-page-handler="Finalize" asp-route-id="@p.Id" class="d-inline" onsubmit="return confirm('Finalisasi periode ini? Pastikan semua bawahan sudah ditinjau Manager.');">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Finalisasi</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Periods.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">Belum ada periode KPI.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

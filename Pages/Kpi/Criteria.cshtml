@page
@model HRIS.Api.Pages.Kpi.CriteriaModel
@{
    ViewData["Title"] = "Kriteria KPI";
}

<h4 class="mb-3">Kriteria Penilaian KPI</h4>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3">
            <h6>Tambah Kriteria</h6>
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <form method="post" asp-page-handler="Create">
                <div class="mb-2">
                    <label class="form-label small">Nama Kriteria</label>
                    <input asp-for="Input.Name" class="form-control form-control-sm" placeholder="mis. Kedisiplinan" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Bobot (%)</label>
                    <input asp-for="Input.Weight" type="number" step="0.01" class="form-control form-control-sm" />
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100">Tambah</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-3">
            @if (Model.TotalWeight != 100 && Model.Criteria.Any())
            {
                <div class="alert alert-warning py-2 small">
                    Total bobot saat ini <strong>@Model.TotalWeight%</strong> — idealnya 100%.
                </div>
            }
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nama</th>
                        <th>Bobot</th>
                        <th class="text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Criteria)
                    {
                        <tr>
                            <td>
                                <form method="post" asp-page-handler="Update" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <input type="text" name="name" value="@c.Name" class="form-control form-control-sm" style="min-width: 150px;" />
                                    <input type="number" step="0.01" name="weight" value="@c.Weight" class="form-control form-control-sm" style="width: 90px;" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Simpan</button>
                                </form>
                            </td>
                            <td>@c.Weight%</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" onsubmit="return confirm('Hapus kriteria @c.Name?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Criteria.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted py-3">Belum ada kriteria.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@page
@model HRIS.Api.Pages.Kpi.ReviewDetailModel
@{
    ViewData["Title"] = "Detail Review KPI";
}

@if (Model.Summary is not null)
{
    var s = Model.Summary;
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Review KPI &mdash; @s.EmployeeName</h4>
        <a asp-page="/Kpi/Review" asp-route-periodId="@Model.PeriodId" class="btn btn-sm btn-outline-secondary">&larr; Kembali</a>
    </div>

    <div class="card p-3 mb-3">
        <div class="text-muted small">Skor Akhir (&Sigma; Score &times; Weight)</div>
        <div class="fs-3 fw-bold">@s.FinalScore.ToString("N2")</div>
    </div>

    <div class="card p-3">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Kriteria</th>
                    <th>Bobot</th>
                    <th>Skor Saat Ini</th>
                    <th>Diisi Oleh</th>
                    <th>Override</th>
                    <th>Riwayat Revisi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var score in s.Scores)
                {
                    <tr>
                        <td>@score.CriteriaName</td>
                        <td>@score.CriteriaWeight%</td>
                        <td class="fw-bold">@score.Score</td>
                        <td class="small text-muted">@score.FilledByUsername</td>
                        <td>
                            <details>
                                <summary class="btn btn-sm btn-outline-warning">Override</summary>
                                <form method="post" asp-page-handler="Override" class="border rounded p-2 mt-2" style="min-width: 220px;">
                                    <input type="hidden" name="scoreId" value="@score.Id" />
                                    <label class="form-label small">Nilai Baru</label>
                                    <input type="number" step="0.01" min="0" max="100" name="newScore" value="@score.Score" class="form-control form-control-sm mb-1" />
                                    <label class="form-label small">Catatan (wajib)</label>
                                    <textarea name="note" class="form-control form-control-sm mb-1" required></textarea>
                                    <button type="submit" class="btn btn-warning btn-sm w-100">Simpan Override</button>
                                </form>
                            </details>
                        </td>
                        <td>
                            @if (score.Revisions.Any())
                            {
                                <details>
                                    <summary class="small text-primary" style="cursor:pointer;">@score.Revisions.Count revisi</summary>
                                    <ul class="small mb-0 mt-1">
                                        @foreach (var rev in score.Revisions.OrderByDescending(r => r.RevisedAt))
                                        {
                                            <li>
                                                @rev.PreviousScore &rarr; @rev.NewScore
                                                oleh @rev.RevisedByUsername (@rev.RevisedAt.ToString("dd MMM yyyy HH:mm"))<br />
                                                <span class="text-muted">"@rev.Note"</span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                            else
                            {
                                <span class="text-muted small">Belum pernah diubah</span>
                            }
                        </td>
                    </tr>
                }
                @if (!s.Scores.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">Belum ada nilai untuk karyawan ini.</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@page
@model HRIS.Api.Pages.Performance.IndexModel
@{ViewData["Title"]="Performance Management";}
<div class="page-heading"><div><div class="text-muted small">Modul 12</div><h4 class="mb-1">Performance Management</h4><p class="text-muted mb-0">Plan, task, dan work log kinerja karyawan.</p></div></div>
<div class="card p-3 mb-3"><h6>Buat Performance Plan</h6><form method="post" asp-page-handler="Plan" class="row g-2">@if(Model.IsHrOrSupport){<div class="col-md-4"><label class="form-label small">Karyawan</label><select asp-for="EmployeeId" class="form-select form-select-sm"><option value="">Pilih</option>@foreach(var e in Model.Employees.Where(x=>x.IsActive)){<option value="@e.Id">@e.EmployeeNumber - @e.FullName</option>}</select></div>}<div class="col-md-3"><label class="form-label small">Mulai</label><input asp-for="StartDate" type="date" class="form-control form-control-sm"/></div><div class="col-md-3"><label class="form-label small">Selesai</label><input asp-for="EndDate" type="date" class="form-control form-control-sm"/></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary btn-sm w-100">Buat Plan</button></div></form></div>
<div class="row g-3">@foreach(var p in Model.Plans){<div class="col-12"><div class="card p-3"><div class="d-flex justify-content-between"><div><h6 class="mb-1">@p.EmployeeName</h6><div class="small text-muted">@p.StartDate.ToString("dd MMM yyyy") - @p.EndDate.ToString("dd MMM yyyy")</div></div><span class="status-@p.Status">@p.Status</span></div><hr/><div class="row g-3"><div class="col-lg-7"><div class="small fw-semibold mb-2">Tasks</div>@foreach(var t in p.Tasks){<div class="border rounded p-2 mb-2 d-flex justify-content-between"><div>@t.Title <span class="text-muted small">@t.DueDate?.ToString("dd/MM/yyyy")</span></div><form method="post" asp-page-handler="TaskStatus" asp-route-id="@t.Id"><select name="status" onchange="this.form.submit()" class="form-select form-select-sm"><option selected="@(t.Status=="Open")">Open</option><option selected="@(t.Status=="InProgress")">InProgress</option><option selected="@(t.Status=="Done")">Done</option><option selected="@(t.Status=="Cancelled")">Cancelled</option></select></form></div>}<form method="post" asp-page-handler="Task" class="row g-1"><input type="hidden" name="PlanId" value="@p.Id"/><div class="col"><input name="TaskTitle" class="form-control form-control-sm" placeholder="Task baru"/></div><div class="col-auto"><input name="TaskDueDate" type="date" class="form-control form-control-sm"/></div><div class="col-auto"><button class="btn btn-sm btn-outline-primary">Tambah</button></div></form></div><div class="col-lg-5"><div class="small fw-semibold mb-2">Work Log</div>@foreach(var w in p.WorkLogs.Take(4)){<div class="small border-bottom py-1">@w.LoggedAt.ToLocalTime().ToString("dd/MM HH:mm") — @w.Description</div>}<form method="post" asp-page-handler="Log" class="mt-2"><input type="hidden" name="PlanId" value="@p.Id"/><textarea name="WorkDescription" class="form-control form-control-sm mb-1" rows="2" placeholder="Catatan pekerjaan..."></textarea><button class="btn btn-sm btn-outline-success">Tambah Work Log</button></form></div></div></div></div>}@if(!Model.Plans.Any()){<div class="col-12"><div class="card p-4 text-center text-muted">Belum ada performance plan.</div></div>}</div>
@page
@model HRIS.Api.Pages.Parking.IndexModel
@{ ViewData["Title"] = "Parking"; }
<div class="row g-3"><div class="col-lg-4"><div class="card p-3"><h6>Registrasi Parkir</h6><form method="post" asp-page-handler="Create"><div class="mb-2"><label class="form-label small">Jenis kendaraan</label><select name="vehicleTypeId" class="form-select" required>@foreach(var t in Model.VehicleTypes){<option value="@t.Id">@t.Name</option>}</select></div><div class="mb-3"><label class="form-label small">Nomor polisi</label><input name="plateNumber" class="form-control" maxlength="30" required /></div><button class="btn btn-primary">Ajukan</button></form></div></div><div class="col-lg-8"><div class="card p-3"><h5 class="mb-3">Registrasi Parkir</h5><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Pengaju</th><th>Kendaraan</th><th>Plat</th><th>Status</th>@if(Model.CanManage){<th>Aksi</th>}</tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.EmployeeName</td><td>@x.VehicleTypeName</td><td><strong>@x.PlateNumber</strong></td><td><span class="status-@x.Status">@x.Status</span></td>@if(Model.CanManage){<td>@if(x.Status=="Approved"){<form method="post" asp-page-handler="Status" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="status" value="CardReady"/><button class="btn btn-sm btn-outline-primary">Kartu Siap</button></form>}else if(x.Status=="CardReady"){<form method="post" asp-page-handler="Status" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="status" value="Collected"/><button class="btn btn-sm btn-outline-success">Sudah Diambil</button></form>}else{<span class="text-muted small">-</span>}</td>}</tr>}@if(!Model.Items.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Belum ada registrasi.</td></tr>}</tbody></table></div></div></div></div>
